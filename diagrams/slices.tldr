              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Each slice is end to end, builds on the one before, and ends in an automated test. Slices 1–5 run against the in-memory fake HR platform; the contract suite runs from slice 1."
                }
              ]
            }
          ]
        },
        "scale": 1,
        "autoSize": false
      }
