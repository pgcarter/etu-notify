            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "1. Happy path from an event"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "our event format → ledger"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "→ worker → port → Delivered"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "same event twice = 1 record"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Blocked on: nothing"
                }
              ]
            }
          ]
